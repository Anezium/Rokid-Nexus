<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Deliberately no POST_NOTIFICATIONS: plugin foreground services must stay
         invisible; the Rokid Nexus hub notification is the single user-facing one. -->

    <queries>
        <intent>
            <action android:name="com.anezium.rokidbus.action.HUB" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sample">

        <activity
            android:name=".HelloActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".HelloPluginService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="glasses-session" />
            <intent-filter>
                <action android:name="com.anezium.rokidbus.action.PLUGIN" />
            </intent-filter>
            <meta-data
                android:name="com.anezium.rokidbus.plugin.ID"
                android:value="hello" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.DISPLAY_NAME"
                android:value="Hello Nexus" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.ICON"
                android:value="star" />
            <!-- Alternative custom glyph (remove ICON above before enabling):
            <meta-data
                android:name="com.anezium.rokidbus.plugin.ICON_DRAWABLE"
                android:resource="@drawable/nexus_glyph_sample" />
            -->
            <meta-data
                android:name="com.anezium.rokidbus.plugin.API_VERSION"
                android:value="3" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.CAPABILITIES"
                android:value="surfaces,stt,tts,ink_surface,microphone" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.RECEIVE_PREFIXES"
                android:value="/plugin/hello,/system/plugin,/stt,/tts/started,/tts/done,/audio" />
            <!-- The todo example: pages (the Applications row then opens hello:main), the
                 checklist family the user may approve to run on one tap, and the activity's
                 glyph. Descriptor metadata, not capabilities: the existing grant is kept. -->
            <meta-data
                android:name="rokidbus.plugin.pages"
                android:value="1" />
            <meta-data
                android:name="rokidbus.plugin.quickActions"
                android:value="checklist" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.GLYPHS"
                android:resource="@array/nexus_glyphs" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.SETTINGS_ACTIVITY"
                android:value=".HelloActivity" />
            <meta-data
                android:name="com.anezium.rokidbus.plugin.LAUNCHABLE"
                android:value="true" />
        </service>
    </application>
</manifest>
