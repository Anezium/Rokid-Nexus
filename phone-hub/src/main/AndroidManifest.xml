<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.anezium.rokidbus.permission.BIND_PLUGIN_GUARDIAN"
        android:protectionLevel="signature" />
    <permission
        android:name="com.anezium.rokidbus.phone.permission.INTERNAL_CORE_CONTROL"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.anezium.rokidbus.permission.BIND_PLUGIN_GUARDIAN" />
    <uses-permission android:name="com.anezium.rokidbus.phone.permission.INTERNAL_CORE_CONTROL" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The Store detail screen's Remove card; without this, ACTION_DELETE is silently dropped. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.rokid.sprite.global.aiapp" />
        <intent>
            <action android:name="com.rokid.sprite.aiapp.externalapp.AUTHORIZATION" />
        </intent>
        <intent>
            <action android:name="com.rokid.sprite.aiapp.externalapp.MEDIA_STREAM_SERVICE" />
        </intent>
        <intent>
            <action android:name="com.anezium.rokidbus.action.CLIENT" />
        </intent>
        <intent>
            <action android:name="com.anezium.rokidbus.action.PLUGIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RokidBus.Phone">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StorePluginDetailActivity"
            android:exported="false"
            android:parentActivityName=".StoreActivity" />

        <activity
            android:name=".StoreVersionHistoryActivity"
            android:exported="false"
            android:parentActivityName=".StorePluginDetailActivity" />

        <activity
            android:name=".WhatsNewActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".StoreScreenshotViewerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:parentActivityName=".StorePluginDetailActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".BusInspectorActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".PluginPermissionsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".ConsoleActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".GlassesDisplaySettingsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".SpeechSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".VoiceSettingsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".GlassesSetupGuideActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".GlassesManualSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".RemoteInputActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".NativeAppsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".BusHubService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice|microphone">
            <intent-filter>
                <action android:name="com.anezium.rokidbus.action.HUB" />
            </intent-filter>
        </service>

        <receiver
            android:name=".PluginInstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".HubStartupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
